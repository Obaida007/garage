{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Al-Sahil Garage",
  "version": "1.0.0",
  "identifier": "com.alsahil.garage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Al-Sahil Garage",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "maximized": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installMode": "both",
        "shortcutName": "Al-Sahil Garage"
      }
    },
    "shortDescription": "نظام إدارة أدوار كراج الساحل",
    "longDescription": "تطبيق مكتبي لإدارة أدوار الزبائن في كراج تغيير زيت السيارات، مع طباعة حرارية وشاشة انتظار.",
    "publisher": "Al-Sahil Garage",
    "category": "Business",
    "copyright": "Al-Sahil Garage"
  },
  "plugins": {
    "autostart": {
      "windows": true
    }
  }
}
